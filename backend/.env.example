# ChatBook configuration
# Copy this file to .env and fill in your values

# ============================================================
# LLM CONFIGURATION
# ============================================================

# Set to "true" to use local Ollama instead of Groq.
# Ollama is free and private but slower. Groq is faster, free up to
# 14,400 requests/day, but sends data to a third-party server.
USE_OLLAMA=false

# Required if USE_OLLAMA=false. Get from https://console.groq.com
GROQ_API_KEY=

# Models. Defaults are fine to start.
# Groq models: llama-3.1-8b-instant (fast), llama-3.3-70b-versatile (better)
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_STRONG=llama-3.3-70b-versatile

# Ollama models (only used if USE_OLLAMA=true)
OLLAMA_MODEL_FAST=llama3.1:8b
OLLAMA_MODEL_STRONG=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# ============================================================
# IMAGE GENERATION
# ============================================================

# How images are chosen for each chapter.
#   false (default) → pick from curated SVG cliparts in
#                      frontend/static/cliparts/. Free, instant, no API.
#   true            → try Gemini AI image generation first, fall back to
#                      clipart on rate limit or error. Only enable if you
#                      have paid Gemini or budget for the free tier.
USE_GEMINI_IMAGES=false

# Only needed if USE_GEMINI_IMAGES=true.
# Get from https://aistudio.google.com/apikey
# Free tier: 500 images/day, ~10/minute, no credit card.
GEMINI_API_KEY=

# Style for AI-generated images. Edit this to taste.
# Only used when USE_GEMINI_IMAGES=true.
IMAGE_STYLE=flat vector cartoon illustration, soft pastel colors, warm and cozy, no text in image

# ============================================================
# BOOK CONFIGURATION
# ============================================================

# How many chapters in the book.
#   0       = AUTO (recommended) — scales with chat length:
#               1-day chat       → 1 chapter
#               1 month          → 3 chapters
#               6 months         → 4-6 chapters
#               1 year           → 6-8 chapters
#               2 years          → 9-12 chapters
#               5+ years         → 12-15 chapters (capped)
#   1-20    = Force exactly this many chapters
# More chapters = more LLM cost + longer book. For Ollama/local mode,
# stick to AUTO or set 3-5 to keep overnight runs manageable.
CHAPTERS_PER_BOOK=0

# How many chapters appear in the free preview (the rest are paywalled)
PREVIEW_CHAPTERS=1

# Currency symbol and price shown in the paywall page
CURRENCY_SYMBOL=₹
FULL_BOOK_PRICE=399

# ============================================================
# STORAGE
# ============================================================

# Hours to keep raw uploaded chat data after job completion.
# Set to 0 to keep forever (NOT recommended for production).
# Final PDFs are kept regardless.
AUTO_DELETE_AFTER_HOURS=24

# Maximum file size accepted (in MB)
MAX_UPLOAD_SIZE_MB=200

# Maximum messages we'll process. Above this, we ask user to
# pick a date range.
MAX_MESSAGES=300000

# ============================================================
# APP
# ============================================================

# Set to a random string. Used for signing job download URLs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-something-random

# Show debug pages and verbose logs. Always false in production.
DEBUG=true
