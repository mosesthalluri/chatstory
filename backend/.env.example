# ChatBook configuration
# Copy this file to .env and fill in your values

# ============================================================
# LLM CONFIGURATION
# ============================================================

# Set to "true" to use local Ollama instead of Groq.
# Ollama is free and private but slower. Groq is faster, free up to
# 14,400 requests/day, but sends data to a third-party server.
USE_OLLAMA=true

# Required if USE_OLLAMA=false. Get from https://console.groq.com
GROQ_API_KEY=

# Models. Defaults are fine to start.
# Groq models: llama-3.1-8b-instant (fast), llama-3.3-70b-versatile (better)
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_STRONG=llama-3.3-70b-versatile

# Ollama models (only used if USE_OLLAMA=true)
OLLAMA_MODEL_FAST=llama3.1:8b
OLLAMA_MODEL_STRONG=llama3.1:8b
OLLAMA_HOST=http://localhost:11434

# Ollama context window in tokens.
# CRITICAL: Ollama's DEFAULT is only 2048 tokens, which silently
# truncates our chapter prompts (~2500 tokens) and causes the LLM
# to write nonsense about "technical issues" / "factual summaries" —
# because it only sees the output-format instructions at the end of
# our truncated prompt, not the actual messages.
#
# 16384 = safe default, fits all our prompts with room to spare,
#         uses ~2-3 GB extra RAM during inference
# The commentary writer runs small sequential prompts. 8192 is the
# recommended local setting for i7/8GB machines.
# Increase only if your model and RAM can handle it.
OLLAMA_NUM_CTX=8192

# ============================================================
# IMAGE GENERATION
# ============================================================

# How images are chosen for each chapter.
#   false (default) → pick from curated SVG cliparts in
#                      frontend/static/cliparts/. Free, instant, no API.
#   true            → try Gemini AI image generation first, fall back to
#                      clipart on rate limit or error. Only enable if you
#                      have paid Gemini or budget for the free tier.
USE_GEMINI_IMAGES=false

# Only needed if USE_GEMINI_IMAGES=true.
# Get from https://aistudio.google.com/apikey
# Free tier: 500 images/day, ~10/minute, no credit card.
GEMINI_API_KEY=

# Style for AI-generated images. Edit this to taste.
# Only used when USE_GEMINI_IMAGES=true.
IMAGE_STYLE=flat vector cartoon illustration, soft pastel colors, warm and cozy, no text in image

# ============================================================
# PDF CLIPART (the "PDF Clipart" web product)
# ============================================================
# backend: local (Stable Diffusion via diffusers — needs torch installed),
#          api (remote image service), or stub (offline placeholder, no GPU).
PDF_CLIPART_BACKEND=local
PDF_CLIPART_MODEL=sd-turbo
PDF_CLIPART_STEPS=2
PDF_CLIPART_MAX_PER_PAGE=2
# Reuse a model you already have instead of downloading. Point at a
# single-file .safetensors/.ckpt (A1111/ComfyUI) or a diffusers folder.
# Pair a single-file SD 1.5 checkpoint with PDF_CLIPART_MODEL=sd15-lcm.
PDF_CLIPART_MODEL_PATH=

# ============================================================
# BOOK CONFIGURATION
# ============================================================

# How many chapters in the book.
#   0       = AUTO (recommended) — scales with chat length:
#               1-day chat       → 1 chapter
#               1 month          → 3 chapters
#               6 months         → 4-6 chapters
#               1 year           → 6-8 chapters
#               2 years          → 9-12 chapters
#               5+ years         → 12-15 chapters (capped)
#   1-20    = Force exactly this many chapters
# More chapters = more LLM cost + longer book. For Ollama/local mode,
# stick to AUTO or set 3-5 to keep overnight runs manageable.
CHAPTERS_PER_BOOK=0

# How many chapters appear in the free preview (the rest are paywalled)
PREVIEW_CHAPTERS=1

# Currency symbol and price shown in the paywall page
CURRENCY_SYMBOL=₹
FULL_BOOK_PRICE=399

# Per-export prices for Chat Wrapped / Gift Engine unlocks
SINGLE_EXPORT_PRICE=50
COMBINED_EXPORT_PRICE=75

# ChatStory tiered pricing (chosen by how many messages are in the user's
# selected date range). Change anytime — no code edits needed.
PRICE_SMALL=49
PRICE_MEDIUM=99
PRICE_LARGE=199
MSG_MEDIUM_MIN=2000
MSG_LARGE_MIN=10000

# Gift Engine: use the local LLM (Ollama/Groq) to infer interests/skills and
# suggest creative, personal gift ideas. Falls back to the rule-based engine
# if the model is unavailable. Set false to skip the LLM pass entirely.
GIFT_ENGINE_USE_LLM=true

# ============================================================
# PAYMENTS (manual Paytm / UPI verification)
# ============================================================
PAYTM_UPI_ID=your-paytm-upi@paytm
PAYTM_QR_IMAGE=/static/paytm-qr.png

# Telegram approval bot (optional). Create a bot via @BotFather for the TOKEN,
# and get your numeric chat id from @userinfobot for ADMIN_CHAT_ID. When both
# are set, payment screenshots are pushed to your Telegram with Approve/Reject
# buttons, and you can reply to the user with: /msg <job_id> your message
# Leave blank to use the /admin web approval flow instead.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ============================================================
# ADMIN ACCOUNT
# ============================================================
# If set, this account is created (or promoted to admin) on startup so you
# always have a known admin login at /login. Leave blank to instead let the
# FIRST person who signs up become the admin.
ADMIN_EMAIL=admin@chatbook.local
ADMIN_PASSWORD=change-this-admin-password

# ============================================================
# STORAGE
# ============================================================

# Hours to keep raw uploaded chat data after job completion.
# Set to 0 to keep forever (NOT recommended for production).
# Final PDFs are kept regardless.
AUTO_DELETE_AFTER_HOURS=24

# Maximum file size accepted (in MB)
MAX_UPLOAD_SIZE_MB=200

# Maximum messages we'll process. Above this, we ask user to
# pick a date range.
MAX_MESSAGES=300000

# Rough seconds per job — used only to show an estimated wait time in the
# queue. Tune to your hardware.
AVG_JOB_SECONDS=600

# ============================================================
# EMAIL NOTIFICATIONS (optional)
# ============================================================
# If set, users are emailed when a job finishes and when payment is approved.
# Leave blank to disable (the dashboard is always the primary tracker).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# APP
# ============================================================

# Support email shown in the footer / terms page.
SUPPORT_EMAIL=support@chatstory.app

# "How to export your chats" tutorial videos on the homepage. Paste full
# YouTube URLs (https://www.youtube.com/watch?v=...). Leave blank to show a
# "coming soon" placeholder.
WHATSAPP_EXPORT_VIDEO=
TELEGRAM_EXPORT_VIDEO=
INSTAGRAM_EXPORT_VIDEO=

# Shown on the Terms page.
REFUND_POLICY=Refunds are considered case by case — email support within 7 days of payment.

# Set to a random string. Used for signing job download URLs.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-something-random

# Show debug pages and verbose logs. Always false in production.
DEBUG=true
